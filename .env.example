# ===== 运行模式 =====
# 展示模式（默认，本仓库唯一支持的模式）：LLM 走 FakeChatModel，数据源走 examples/ fixture
DUTY_DISPLAY_MODE=true
# 真实模型占位（本仓库不实跑，留空即可；启用需要人工批准并追加 DECISION-LOG）
DUTY_LLM_MODEL=
DUTY_LLM_API_KEY=

# ===== 档案与存储 =====
DUTY_RESULTS_DIR=results
DUTY_EXAMPLES_DIR=examples/replay-2026-09-16
DUTY_DB_PATH=results/duty.sqlite3
DUTY_OUTBOX_DIR=outbox

# ===== 账户参数（全部为示例值，禁止填真实值）=====
PORTFOLIO_CENTS=100000000
BASE_CASH_CENTS=100000000

# ===== 取证配额（plan §4.2 / §5.3）=====
QUOTA_IFIND=8
QUOTA_VERTICAL_SEARCH=12
QUOTA_GM_KLINE=6

# ===== 池锁定 edge gate（plan §5.1）=====
EDGE_GATE_MIN_LISTED_DAYS=250
EDGE_GATE_MIN_AVG_AMOUNT_CENTS=8000000000

# ===== 盘中反应环（plan §5.5）=====
INTRADAY_MOVE_PCT_BPS=300
INTRADAY_VOLUME_X_VMA5=250
INTRADAY_SLOW_INTERVAL_SECONDS=300
INTRADAY_FAST_INTERVAL_SECONDS=60
INTRADAY_COOLDOWN_PER_CODE=2
INTRADAY_COOLDOWN_GLOBAL=4

# ===== 企业微信（留空则落盘 outbox，plan §9）=====
WECOM_WEBHOOK_URL=
DUTY_CONFIRM_BASE_URL=http://127.0.0.1:8501/confirm

# ===== 记忆 KB（plan §6）=====
KB_INDEX_PATH=results/kb.sqlite3
KB_RECALL_TOP_K=5
