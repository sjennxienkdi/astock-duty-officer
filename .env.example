# 全部为占位符或示例值（plan §16）。展示模式是本仓库唯一支持的模式。
# 键名即 duty_agent.config.Settings 字段名，由 pydantic-settings 读取。

# ===== 运行模式 =====
DISPLAY_MODE=true
# 真实模型占位：本仓库不实跑，留空即走 FakeChatModel + cassette
LLM_MODEL=

# ===== 路径 =====
RESULTS_DIR=results
EXAMPLES_DIR=examples/replay-2026-09-16
DB_PATH=results/duty.sqlite3
OUTBOX_DIR=outbox
KB_INDEX_PATH=results/kb.sqlite3
KB_RECALL_TOP_K=5

# ===== 账户参数（示例值）=====
PORTFOLIO_CENTS=100000000

# ===== 决策实例 =====
DECISION_TAGS=gpt,claude,glm

# ===== 取证配额（plan §4.2 / §5.3）=====
QUOTA_IFIND=8
QUOTA_VERTICAL_SEARCH=12
QUOTA_GM_KLINE=6

# ===== 池锁定 edge gate（plan §5.1）=====
EDGE_GATE_MIN_LISTED_DAYS=250
EDGE_GATE_MIN_AVG_AMOUNT_CENTS=8000000000

# ===== 算仓（plan §5.1，引擎参数）=====
SINGLE_NAME_MAX_BPS=1000
STOP_LOSS_BPS=300

# ===== 盘中反应环（plan §5.5，倍数用万分比：2.5 倍 = 25000）=====
INTRADAY_MOVE_TRIGGER_BPS=300
INTRADAY_VOLUME_MULTIPLE_BPS=25000
SLOW_INTERVAL_SECONDS=300
FAST_INTERVAL_SECONDS=60
INTRADAY_PER_CODE=2
INTRADAY_GLOBAL_MAX=4

# ===== 企业微信（留空则落 outbox，plan §9）=====
WECOM_WEBHOOK_URL=
CONFIRM_BASE_URL=http://127.0.0.1:8501/confirm
